<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.bnet-mac-fixer.menubar</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/bnet-mac-fixer</string>
        <string>menubar</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after a crash, but "Quit Menu Bar Icon" (a clean exit) keeps it off until next login. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/bnet-mac-fixer-menubar.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/bnet-mac-fixer-menubar.log</string>
</dict>
</plist>
